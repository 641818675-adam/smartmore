{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PartFinder Mobile 体验反馈记录",
  "type": "object",
  "required": ["type", "submitted_at", "rating", "app_version"],
  "properties": {
    "type": { "const": "partfinder-feedback", "description": "记录类型标识" },
    "submitted_at": { "type": "string", "format": "date-time", "description": "提交时间（ISO 8601）" },
    "rating": { "type": "integer", "minimum": 1, "maximum": 5, "description": "整体体验打分" },
    "categories": {
      "type": "array",
      "items": { "enum": ["搜索", "选型", "竞品", "客户", "界面", "性能", "其他"] },
      "description": "问题/建议类型，可多选"
    },
    "message": { "type": "string", "maxLength": 2000, "description": "自由描述（选填）" },
    "app_version": { "type": "string", "description": "客户端版本，如 10.1.0-rc2" },
    "data_version": { "type": "string", "description": "产品数据版本，如 9.7.0" },
    "data_count": { "type": "integer", "description": "本地物料条数" },
    "screen_width": { "type": "integer", "description": "视口宽度 px（折叠形态参考）" },
    "screen_height": { "type": "integer", "description": "视口高度 px" },
    "dark_mode": { "type": "boolean", "description": "是否深色模式" },
    "simulated": {
      "type": "boolean",
      "default": false,
      "description": "true = 模拟面板生成（本沙箱无真实用户通道时使用），聚合报告必须显式标注"
    },
    "panelist": {
      "type": "string",
      "description": "模拟面板编号（仅 simulated=true 时存在），如 P-07"
    },
    "evidence": {
      "type": "string",
      "description": "证据链：该反馈对应 findings 中哪条可复现证据（仅 simulated=true 时存在）"
    },
    "finding_id": {
      "type": "string",
      "description": "关联的 finding 编号（仅 simulated=true 时存在），如 R1-03"
    }
  }
}
